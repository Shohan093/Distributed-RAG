# Rendered by site.yml -- do not edit on the VM directly, edit
# group_vars/all.yml (or this template) and re-run the playbook instead.
VM_ROLE={{ vm_role }}
VM_ADVERTISED_HOST={{ ansible_host | default(inventory_hostname) }}

KAFKA_BOOTSTRAP_SERVERS={{ hostvars[groups['broker'][0]]['ansible_host'] }}:9092
KAFKA_TOPIC_DOCS={{ kafka_topic_docs | default('docs-raw') }}
KAFKA_TOPIC_LOGS={{ kafka_topic_logs | default('logs-raw') }}
KAFKA_NUM_PARTITIONS={{ kafka_num_partitions | default(8) }}

SPARK_MASTER_HOST={{ hostvars[groups['spark_master'][0]]['ansible_host'] }}
SPARK_WORKER_CORES={{ spark_worker_cores | default(2) }}
SPARK_WORKER_MEMORY={{ spark_worker_memory | default('2g') }}

REDIS_HOST={{ hostvars[groups['storage'][0]]['ansible_host'] }}
REDIS_PORT=6379

MINIO_HOST={{ hostvars[groups['storage'][0]]['ansible_host'] }}
MINIO_PORT=9000
MINIO_ROOT_USER={{ minio_root_user | default('driftdrag') }}
MINIO_ROOT_PASSWORD={{ minio_root_password | default('driftdrag-dev-only') }}
MINIO_BUCKET={{ minio_bucket | default('driftdrag-lake') }}

MLFLOW_TRACKING_URI=http://{{ hostvars[groups['storage'][0]]['ansible_host'] }}:5000

NUM_SHARDS={{ num_shards | default(32) }}
EMBEDDING_DIM={{ embedding_dim | default(128) }}
NUM_SPARK_EXECUTORS={{ num_spark_executors | default(groups['spark_worker'] | length) }}
