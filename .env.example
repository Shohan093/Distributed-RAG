# Copy to .env and edit per environment. Every hostname here is what lets
# the exact same docker-compose.yml + docker-compose.cluster.yml pair be
# reused unchanged when the stack moves from one dev VM to N VMs -- only
# these values change, never the compose files or application code.

# --- identity of THIS host when running docker-compose.cluster.yml ---
VM_ROLE=broker            # one of: broker | spark-master | spark-worker | storage | client
VM_ADVERTISED_HOST=127.0.0.1   # this VM's routable IP/hostname on the cluster network

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DOCS=docs-raw
KAFKA_TOPIC_LOGS=logs-raw
KAFKA_NUM_PARTITIONS=8

# --- Spark ---
SPARK_MASTER_URL=spark://localhost:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# --- Drift State Ledger (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Object store / data lake (MinIO, S3-compatible) ---
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=driftdrag
MINIO_ROOT_PASSWORD=driftdrag-dev-only
MINIO_BUCKET=driftdrag-lake

# --- MLflow tracking ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- experiment scale knobs (see configs/experiment/*.yaml) ---
NUM_SHARDS=32
EMBEDDING_DIM=128
